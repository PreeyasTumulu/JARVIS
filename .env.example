# Copy to .env and fill in only what you use. .env is gitignored.

# Phase 4: market and utility data (all have free tiers)
FINNHUB_API_KEY=
TWELVEDATA_API_KEY=
ALPHAVANTAGE_API_KEY=
COINGECKO_API_KEY=

# Phase 8: free cloud models for heavy public questions (both optional; without them Jarvis
# stays on the local model). Groq: console.groq.com. OpenRouter: openrouter.ai.
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Phase 9: reaching your phone from the Claude Code bridge (bridge.phone in config). Optional.
# ntfy: an access token that protects your topics (ntfy.sh account or your own server).
NTFY_TOKEN=
# Twilio (paid): console.twilio.com, Account Info.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Phase 11: your mailbox and calendar (SETUP.md 5k). Optional.
# A Gmail app password (myaccount.google.com/apppasswords; needs 2-Step Verification).
MAIL_APP_PASSWORD=
# Your calendar's secret iCal address (Google Calendar settings, Integrate calendar).
# Several calendars: separate the links with spaces.
CALENDAR_ICS_URL=
